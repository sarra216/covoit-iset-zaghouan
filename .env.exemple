# Copier ce fichier en « .env » (même dossier) et remplir les valeurs.
# Ne JAMAIS mettre le fichier .env sur GitHub : il contient les mots de passe.

# Base de données
DATABASE_PASSWORD=choisir-un-mot-de-passe-solide
MYSQL_ROOT_PASSWORD=choisir-un-autre-mot-de-passe-solide

# Clé qui signe les jetons de connexion : une longue phrase aléatoire (32 caractères minimum)
JWT_SECRET=remplacer-par-une-longue-phrase-aleatoire-et-secrete

# Adresse publique du site (utilisée dans les liens des emails)
APP_URL=http://localhost:3000

# Compte administrateur : s'inscrire avec cet email, puis redémarrer l'application
ADMIN_EMAIL=

# Domaines autorisés à l'inscription, séparés par des virgules (vide = tous)
# Exemple si l'ISET fournit des adresses institutionnelles : iset-zaghouan.tn
DOMAINES_AUTORISES=

# Vérification de l'email à l'inscription (true conseillé en production, nécessite le SMTP ci-dessous)
EMAIL_VERIFICATION=true

# Envoi des emails (exemple Gmail : smtp.gmail.com, port 587, « mot de passe d'application » Google)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
